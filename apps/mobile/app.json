{
  "expo": {
    "name": "PackShot",
    "slug": "packshot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "packshot",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.REPLACE.packshot",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F1EA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.REPLACE.packshot"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F1EA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "PackShot uses the camera to photograph your products.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PackShot needs access to choose product photos from your gallery."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "PackShot saves finished product photos to your gallery.",
          "savePhotosPermission": "PackShot saves finished product photos to your gallery.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-secure-store",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "https://REPLACE_WITH_DOMAIN",
      "supabaseUrl": "https://REPLACE.supabase.co",
      "supabaseAnonKey": "REPLACE",
      "revenuecatIosKey": "",
      "revenuecatAndroidKey": "",
      "eas": {
        "projectId": ""
      }
    }
  }
}