{
  "expo": {
    "name": "PocketShoot",
    "slug": "pocketshoot",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "pocketshoot",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.REPLACE.pocketshoot",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F1EA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.REPLACE.pocketshoot"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4F1EA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "PocketShoot uses the camera to photograph your products.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "PocketShoot needs access to choose product photos from your gallery."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "PocketShoot saves finished product photos to your gallery.",
          "savePhotosPermission": "PocketShoot saves finished product photos to your gallery.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-secure-store",
      "expo-localization"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "https://pocketshoot.vercel.app",
      "supabaseUrl": "https://vsgsoqofddqodbmarpkx.supabase.co",
      "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZzZ3NvcW9mZGRxb2RibWFycGt4Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTMwMzE2MzQsImV4cCI6MjEwODYwNzYzNH0.ELCyiRvg0eG1EnYAUOQnDjd6LcZxi8OB_hNqvWaX888",
      "revenuecatIosKey": "",
      "revenuecatAndroidKey": "",
      "eas": {
        "projectId": ""
      }
    }
  }
}