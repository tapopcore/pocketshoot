# ---- App
NEXT_PUBLIC_APP_NAME=PackShot
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_SUPPORT_EMAIL=support@your-domain.com
NEXT_PUBLIC_SUPPORT_WHATSAPP=
# Comma-separated emails that get platform admin access
PLATFORM_ADMIN_EMAILS=you@your-domain.com
# Random 32+ char strings
CRON_SECRET=
ENCRYPTION_KEY=

# ---- Supabase (database, login, private storage)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI providers (at least one; without any, a clearly labelled sandbox makes placeholder images)
GEMINI_API_KEY=
OPENAI_API_KEY=
FAL_KEY=

# ---- Razorpay (website payments). Without keys, set ALLOW_SANDBOX_PAYMENTS=true to test (never in production)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ALLOW_SANDBOX_PAYMENTS=false

# ---- Shopify app
SHOPIFY_API_KEY=
NEXT_PUBLIC_SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_API_VERSION=2026-07
NEXT_PUBLIC_SHOPIFY_APP_URL=

# ---- Mobile in-app purchases (RevenueCat webhook authorization value)
REVENUECAT_WEBHOOK_AUTH=
NEXT_PUBLIC_IOS_URL=
NEXT_PUBLIC_ANDROID_URL=

# ---- Email (Resend) for job-ready emails, invites and alerts
RESEND_API_KEY=
EMAIL_FROM=PackShot <hello@your-domain.com>
ALERT_EMAIL=
